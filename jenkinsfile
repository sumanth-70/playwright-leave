pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out code from GitHub...'
                checkout scm
            }
        }
        stage('Install dependencies') {
            steps {
                bat 'npm install'
            }
        }
        stage('Install Playwright') {
            steps {
                bat 'npx playwright install'
            }
        }
        stage('Running test') {
            steps {
                bat 'npx playwright test'
            }
        }
    }
        post{
            always{
                    echo 'Building the application...'
            }
                
            }
        }
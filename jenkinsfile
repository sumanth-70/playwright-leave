pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out code from GitHub...'
                checkout scm
            }
        }
        stage('Check Node') {
    steps {
        sh '''
            echo "PATH=$PATH"
            which node || true
            which npm || true
            node --version || true
            npm --version || true
        '''
    }
}
        stage('Install dependencies') {
            steps {
                sh 'npm install'
            }
        }
        stage('Install Playwright') {
            steps {
                sh 'npx playwright install'
            }
        }
        stage('Running test') {
            steps {
                sh 'npx playwright test'
            }
        }
    }
        post{
            always{
                    echo 'Building the application...'
            }
                
            }
        }
